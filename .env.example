# ---------------------------------------------------------------------------
# LLM PROVIDER — set ONE of these. The provider is auto-detected from whichever
# key is present (OpenRouter first, then Gemini, then OpenAI), so you do not
# need a separate provider flag unless you want to force one.
# ---------------------------------------------------------------------------

# OpenRouter — cheapest, and the default model (z-ai/glm-5.2) is what this app
# is tuned against. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Gemini via Google's OpenAI-compatible endpoint. Free tier available, but the
# free rate limit (5 req/min) is too tight for a multi-agent turn.
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Optional: force a provider / model regardless of which keys are present.
# MEDBOARD_* is accepted as an alias for CANCERPATIENT_* so an .env copied from
# the AI Tumor Board works unchanged.
# CANCERPATIENT_PROVIDER=openrouter        # openrouter | gemini | openai
# CANCERPATIENT_MODEL=z-ai/glm-5.2

# Reasoning ("thinking") budget: none | low | medium | high | default.
# Defaults to high. `low` is dramatically faster and is what the tuned setup
# uses — the safety-critical institution-naming pass overrides itself back to high.
# CANCERPATIENT_REASONING_EFFORT=low

# Output token cap. Matters on OpenRouter: an unset max_tokens is checked against
# the model's FULL output budget and 402s unless your balance covers all of it.
# CANCERPATIENT_MAX_TOKENS=16384


# ---------------------------------------------------------------------------
# SEARCH BACKEND — set at least ONE. These power patient_source_search,
# social_resource_search, and patient_stories_search, which are the main tools
# the helpers use. Without one, the helpers can only reach PubMed and will
# abstain on most everyday questions.
# Perplexity is tried first; Brave is the fallback.
# ---------------------------------------------------------------------------

# Perplexity Search API — preferred (cleaner results, no `site:` query limits).
PERPLEXITY_API_KEY=

# Brave Search — free tier 2k queries/mo at https://brave.com/search/api/
Brave_API=


# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# NCBI Entrez credentials — raises the PubMed rate limit from 3 to 10 req/s.
# NCBI_EMAIL=
# NCBI_API_KEY=

# ClinicalTrials.gov, Europe PMC and Semantic Scholar need no key.

# CORS — comma-separated list of allowed origins.
# CANCERPATIENT_ALLOWED_ORIGINS=https://your-domain.example

# Concurrency caps, to prevent runaway spend.
# CANCERPATIENT_MAX_ACTIVE_TURNS=20              # concurrent chat turns, all conversations
# CANCERPATIENT_MAX_TURNS_PER_CONVERSATION=2     # concurrent turns in one chat
# CANCERPATIENT_MAX_ACTIVE_SESSIONS=20           # concurrent one-shot /consult runs

# Per-IP rate limits on the endpoints that spend LLM/search credits. There are no
# accounts, so an open URL is an open tap. Defaults are generous on purpose — a
# clinic or library NATs many real patients behind one IP. Set both to 0 to disable.
# CANCERPATIENT_RATE_PER_HOUR=20
# CANCERPATIENT_RATE_PER_DAY=60

# Logging privacy. Content logging is OPT-IN and must stay off in production: the
# search queries and model replies it would print are built from the patient's own
# words, and the privacy page promises they are never written down.
# CANCERPATIENT_LOG_CONTENT=0
# CANCERPATIENT_LOG_TIMING=1   # per-turn timings; ids/durations/counts only, no text
